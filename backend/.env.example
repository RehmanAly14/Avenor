# ============================================
# AVENOR — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avenor_dev?schema=public"

# ---- Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Dedicated AES-256-GCM key material for data-source credentials (required in production)
DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret

# ---- Security ----
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate Limiting ----
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Bcrypt ----
BCRYPT_ROUNDS=12

# ---- App ----
APP_NAME=Avenor
API_VERSION=v1

# ---- AI Provider (optional) ----
# Leave AI_PROVIDER unset to run the investigation pipeline fully
# deterministically (template-based explanations, no external calls).
AI_PROVIDER=
AI_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_API_KEY=fw_U2QoLyVQVtBwrXiNPSWvoy

# ---- GitHub Integration (optional) ----
# Legacy global fallback (Phase 3) — used only for projects with no
# repository connected via the OAuth flow below. Leave unset to run the
# fix pipeline through approval only — PR creation then returns a clean,
# non-fatal configuration error instead of crashing.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# ---- GitHub OAuth App (optional) ----
# Register an OAuth App at https://github.com/settings/developers with
# callback URL "<your-api-base>/api/v1/github/callback" (or set
# GITHUB_REDIRECT_URI to override). See src/integrations/github/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# Set on the same OAuth App's webhook config (or a separate GitHub App
# webhook) to enable POST /api/v1/github/webhook (pull_request merged/closed).
GITHUB_WEBHOOK_SECRET=
