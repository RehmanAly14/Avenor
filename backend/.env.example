# ============================================
# AVENOR — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avenor_dev?schema=public"

# ---- Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Dedicated AES-256-GCM key material for data-source credentials (required in production)
DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret

# ---- Security ----
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate Limiting ----
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Bcrypt ----
BCRYPT_ROUNDS=12

# ---- App ----
APP_NAME=Avenor
API_VERSION=v1
