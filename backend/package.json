{
  "name": "avenor-backend",
  "version": "1.0.0",
  "description": "Avenor Platform — Backend API Server",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/server": "^1.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "slugify": "^1.6.6",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "keywords": [
    "avenor",
    "saas",
    "ai-platform",
    "multi-agent"
  ],
  "author": "Avenor Team",
  "license": "UNLICENSED",
  "private": true,
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
