// prisma/schema.prisma
// ============================================================
// Avenor — Prisma Data Model
//
// Design principles:
//   - UUIDs as primary keys (no sequential integer IDs exposed)
//   - createdAt / updatedAt on every model
//   - Explicit @map / @@map for snake_case DB columns (JS models stay camelCase)
//   - Cascade deletes defined explicitly — nothing left orphaned
//   - Every unique constraint is intentional and documented
//
// Future models to add here:
//   - WorkspaceMember (many-to-many with roles)
//   - Agent
//   - AgentSession
//   - DataSource
//   - Embedding (pgvector)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL goes through Supabase's transaction-mode pgbouncer pooler
  // (safe for normal query concurrency); migrations need a direct/session
  // connection to take advisory locks and run DDL, hence directUrl.
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────
// User
// The core identity record. All other models reference User.
// ──────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Relations
  projects          Project[]
  workspaces        Workspace[]
  githubConnections GitHubConnection[]
  githubOAuthStates GitHubOAuthState[]

  @@map("users")
}

// ──────────────────────────────────────────────────────────
// Project
// A named container for AI agent work within a workspace.
// slug is the URL-safe identifier used in API routes.
// ──────────────────────────────────────────────────────────
model Project {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Ownership
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  dataSources      DataSource[]
  metadataAssets   MetadataAsset[]
  documents        Document[]
  metadataLineages MetadataLineage[]
  dataIncidents    DataIncident[]

  // The GitHub repository this project's autonomous fixes are proposed
  // against. Optional — a project with no repository connected can still
  // run investigations, it just can't reach the GitHub PR step.
  githubRepositoryId String?           @map("github_repository_id")
  githubRepository   GitHubRepository? @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  githubBranch       String?           @map("github_branch")

  @@index([ownerId])
  @@index([githubRepositoryId])
  @@map("projects")
}

// ──────────────────────────────────────────────────────────
// Workspace
// The top-level organisational unit.
// In future: contains members, projects, and agent configs.
// ──────────────────────────────────────────────────────────
model Workspace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Ownership
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  dataSources      DataSource[]
  metadataAssets   MetadataAsset[]
  metadataOwners   MetadataOwner[]
  metadataTags     MetadataTag[]
  metadataDomains  MetadataDomain[]
  documents        Document[]
  metadataLineages MetadataLineage[]
  dataIncidents    DataIncident[]

  @@index([ownerId])
  @@map("workspaces")
}

enum DataSourceProvider {
  POSTGRESQL
  MYSQL
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum DocumentStatus {
  UPLOADED
  PENDING
  FAILED
}

model DataSource {
  id                String             @id @default(uuid())
  projectId         String             @map("project_id")
  workspaceId       String             @map("workspace_id")
  name              String
  provider          DataSourceProvider
  host              String
  port              Int
  database          String
  username          String
  encryptedPassword String             @map("encrypted_password")
  status            DataSourceStatus   @default(ACTIVE)
  lastSyncedAt      DateTime?          @map("last_synced_at")
  lastError         String?            @map("last_error")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([projectId])
  @@index([workspaceId])
  @@map("data_sources")
}

model MetadataAsset {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  workspaceId  String   @map("workspace_id")
  dataSourceId String?  @map("data_source_id")
  name         String
  description  String?
  qualifiedName String? @unique @map("qualified_name")
  assetType    String   @default("TABLE") @map("asset_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  schemas    MetadataSchema[]
  owners     MetadataOwner[]
  tags       MetadataTag[]
  domainId   String? @map("domain_id")
  domain     MetadataDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  sourceLineages  MetadataLineage[] @relation("LineageSource")
  targetLineages  MetadataLineage[] @relation("LineageTarget")

  @@index([projectId])
  @@index([workspaceId])
  @@index([dataSourceId])
  @@index([domainId])
  @@index([name])
  @@map("metadata_assets")
}

model MetadataSchema {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset   MetadataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  columns MetadataColumn[]

  @@unique([assetId, name])
  @@index([assetId])
  @@map("metadata_schemas")
}

model MetadataColumn {
  id          String   @id @default(uuid())
  schemaId    String   @map("schema_id")
  name        String
  dataType    String   @map("data_type")
  description String?
  isNullable  Boolean  @default(true) @map("is_nullable")
  ordinal     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schema MetadataSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([schemaId, name])
  @@index([schemaId])
  @@map("metadata_columns")
}

model MetadataOwner {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  email       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_owners")
}

model MetadataTag {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_tags")
}

model MetadataDomain {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_domains")
}

model Document {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  workspaceId String         @map("workspace_id")
  filename    String
  fileSize    Int            @map("file_size")
  mimeType    String         @map("mime_type")
  storagePath String         @unique @map("storage_path")
  status      DocumentStatus @default(UPLOADED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
  @@map("documents")
}

// ──────────────────────────────────────────────────────────
// MetadataLineage
// Tracks data lineage relationships between metadata assets.
// Used for impact analysis, investigation, and future AI reasoning.
//
// Lineages are always within the context of a project + workspace.
// Both sourceAssetId and targetAssetId reference the same workspace's
// MetadataAsset records, enforced by the FK constraints.
// ──────────────────────────────────────────────────────────
enum MetadataLineageType {
  UPSTREAM
  DOWNSTREAM
  DERIVED_FROM
  READS_FROM
  WRITES_TO
}

model MetadataLineage {
  id               String              @id @default(uuid())
  projectId        String              @map("project_id")
  workspaceId      String              @map("workspace_id")
  sourceAssetId    String              @map("source_asset_id")
  targetAssetId    String              @map("target_asset_id")
  relationshipType MetadataLineageType @map("relationship_type")
  confidence       Float               @default(1.0)
  metadata         Json?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAsset MetadataAsset @relation("LineageSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAsset MetadataAsset @relation("LineageTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([projectId])
  @@index([workspaceId])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([relationshipType])
  @@map("metadata_lineages")
}

// ──────────────────────────────────────────────────────────
// DataIncident
// Tracks data quality incidents, schema issues, and downstream
// impacts for the future AI DataOps agent.
//
// Affected assets are stored as JSON initially, allowing flexible
// enrichment as the platform evolves.
// ──────────────────────────────────────────────────────────
enum DataIncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FAILED
}

enum DataIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ──────────────────────────────────────────────────────────
// InvestigationStage
// Granular pipeline state for the autonomous investigation
// orchestrator (Planner -> Investigator -> Impact -> Fixer ->
// Documentation). Distinct from DataIncidentStatus, which tracks
// the coarse incident lifecycle (OPEN/INVESTIGATING/RESOLVED/FAILED)
// and is set by the Phase 1 `analyze` endpoint.
// ──────────────────────────────────────────────────────────
enum InvestigationStage {
  PENDING
  PLANNING
  INVESTIGATING
  ANALYZING_IMPACT
  GENERATING_FIX
  DOCUMENTING
  COMPLETED
  FAILED
}

// ──────────────────────────────────────────────────────────
// FixApprovalStatus
// Lifecycle of a proposed fix, independent of InvestigationStage
// (which tracks the read-only investigation pipeline). Human
// approval is mandatory before a pull request is ever opened —
// APPROVED is only ever set by an explicit
// POST /investigations/:id/fix/approve call, never automatically.
// ──────────────────────────────────────────────────────────
enum FixApprovalStatus {
  PROPOSED
  VALIDATED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  PR_CREATED
  RESOLVED
}

// ──────────────────────────────────────────────────────────
// IncidentEvent
// Append-only timeline of everything the autonomous pipeline (and
// human reviewers) did to an incident — powers GET
// /investigations/:id/timeline for the frontend's process view.
// ──────────────────────────────────────────────────────────
enum IncidentEventType {
  INVESTIGATION_STARTED
  ASSET_RESOLVED
  ROOT_CAUSE_FOUND
  IMPACT_ANALYZED
  FIX_GENERATED
  FIX_VALIDATED
  AWAITING_APPROVAL
  FIX_APPROVED
  FIX_REJECTED
  GITHUB_BRANCH_CREATED
  GITHUB_PR_CREATED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  DOCUMENTATION_GENERATED
  INCIDENT_RESOLVED
}

model IncidentEvent {
  id         String            @id @default(uuid())
  incidentId String            @map("incident_id")
  type       IncidentEventType
  message    String
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  incident DataIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([type])
  @@map("incident_events")
}

model DataIncident {
  id              String               @id @default(uuid())
  projectId       String               @map("project_id")
  workspaceId     String               @map("workspace_id")
  title           String
  description     String?
  status          DataIncidentStatus   @default(OPEN)
  severity        DataIncidentSeverity @default(MEDIUM)
  rootCause       String?              @map("root_cause")
  affectedAssets  Json?                @map("affected_assets")
  resolution      String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Autonomous pipeline state (Phase 2). Each field is the structured
  // output of one orchestrator stage, persisted so a run can be
  // inspected or resumed without recomputation.
  stage         InvestigationStage @default(PENDING)
  plan          Json?
  evidence      Json?
  impact        Json?
  proposedFix   Json?              @map("proposed_fix")
  documentation Json?
  error         String?

  // Fix approval + GitHub PR lifecycle (Phase 3). fixApprovalStatus is
  // null until the Fixer stage produces a proposal.
  fixApprovalStatus FixApprovalStatus? @map("fix_approval_status")
  fixValidation     Json?              @map("fix_validation")
  approvedAt        DateTime?          @map("approved_at")
  rejectedAt        DateTime?          @map("rejected_at")
  rejectionReason   String?            @map("rejection_reason")
  githubPr          Json?              @map("github_pr")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    IncidentEvent[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
  @@index([severity])
  @@index([stage])
  @@index([fixApprovalStatus])
  @@map("data_incidents")
}

// ──────────────────────────────────────────────────────────
// GitHub Connection (Phase 4A)
//
// GitHub credentials belong to the user/integration layer, not to any
// one investigation. A user connects their GitHub account once (OAuth
// App flow — see src/integrations/github/README.md for why an OAuth
// App was chosen over a full GitHub App), then links specific
// repositories to specific Projects. The fix/PR flow resolves
// credentials by walking Project -> GitHubRepository -> GitHubConnection,
// falling back to the legacy global GITHUB_TOKEN/OWNER/REPO env vars
// when a project has no repository connected.
//
// The access token is never stored in plaintext — see
// encryptedAccessToken, encrypted with the same AES-256-GCM utility
// (src/utils/encryption.js) already used for DataSource credentials.
// It is never selected into an API response.
// ──────────────────────────────────────────────────────────
enum GitHubConnectionStatus {
  ACTIVE
  REVOKED
}

model GitHubConnection {
  id                   String                 @id @default(uuid())
  userId               String                 @map("user_id")
  githubUserId         String                 @map("github_user_id")
  githubLogin          String                 @map("github_login")
  githubAvatarUrl      String?                @map("github_avatar_url")
  encryptedAccessToken String                 @map("encrypted_access_token")
  scope                String?
  status               GitHubConnectionStatus @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]

  // One connection per (user, GitHub account) — reconnecting the same
  // GitHub account refreshes the token instead of creating a duplicate.
  // A user may still hold multiple connections, one per distinct account.
  @@unique([userId, githubUserId])
  @@index([userId])
  @@map("github_connections")
}

// A repository the connected GitHub account can access, discovered via
// GET /github/repositories and cached so /select can reference a stable
// internal id. githubRepositoryId is GitHub's own numeric id (stored as
// a string — safely outside Int4 range for newer repos, and avoids
// BigInt/JSON-serialization friction in API responses).
model GitHubRepository {
  id                 String   @id @default(uuid())
  connectionId       String   @map("connection_id")
  githubRepositoryId String   @map("github_repository_id")
  owner              String
  name               String
  fullName           String   @map("full_name")
  private            Boolean  @default(false)
  defaultBranch      String   @default("main") @map("default_branch")
  htmlUrl            String   @map("html_url")
  permissions        Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  connection GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  projects   Project[]

  @@unique([connectionId, githubRepositoryId])
  @@index([connectionId])
  @@map("github_repositories")
}

// Short-lived, single-use OAuth CSRF state, tied to the authenticated
// user who initiated GET /github/connect. Validated (not expired, not
// already used) before GET /github/callback exchanges the code.
model GitHubOAuthState {
  id        String    @id @default(uuid())
  state     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("github_oauth_states")
}
