// prisma/schema.prisma
// ============================================================
// Avenor — Prisma Data Model
//
// Design principles:
//   - UUIDs as primary keys (no sequential integer IDs exposed)
//   - createdAt / updatedAt on every model
//   - Explicit @map / @@map for snake_case DB columns (JS models stay camelCase)
//   - Cascade deletes defined explicitly — nothing left orphaned
//   - Every unique constraint is intentional and documented
//
// Future models to add here:
//   - WorkspaceMember (many-to-many with roles)
//   - Agent
//   - AgentSession
//   - DataSource
//   - Embedding (pgvector)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// User
// The core identity record. All other models reference User.
// ──────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Relations
  projects   Project[]
  workspaces Workspace[]

  @@map("users")
}

// ──────────────────────────────────────────────────────────
// Project
// A named container for AI agent work within a workspace.
// slug is the URL-safe identifier used in API routes.
// ──────────────────────────────────────────────────────────
model Project {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Ownership
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  dataSources    DataSource[]
  metadataAssets MetadataAsset[]
  documents      Document[]

  @@index([ownerId])
  @@map("projects")
}

// ──────────────────────────────────────────────────────────
// Workspace
// The top-level organisational unit.
// In future: contains members, projects, and agent configs.
// ──────────────────────────────────────────────────────────
model Workspace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  // Ownership
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  dataSources      DataSource[]
  metadataAssets   MetadataAsset[]
  metadataOwners   MetadataOwner[]
  metadataTags     MetadataTag[]
  metadataDomains  MetadataDomain[]
  documents        Document[]

  @@index([ownerId])
  @@map("workspaces")
}

enum DataSourceProvider {
  POSTGRESQL
  MYSQL
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum DocumentStatus {
  UPLOADED
  PENDING
  FAILED
}

model DataSource {
  id                String             @id @default(uuid())
  projectId         String             @map("project_id")
  workspaceId       String             @map("workspace_id")
  name              String
  provider          DataSourceProvider
  host              String
  port              Int
  database          String
  username          String
  encryptedPassword String             @map("encrypted_password")
  status            DataSourceStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([projectId])
  @@index([workspaceId])
  @@map("data_sources")
}

model MetadataAsset {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  workspaceId  String   @map("workspace_id")
  dataSourceId String?  @map("data_source_id")
  name         String
  description  String?
  qualifiedName String? @unique @map("qualified_name")
  assetType    String   @default("TABLE") @map("asset_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  schemas    MetadataSchema[]
  owners     MetadataOwner[]
  tags       MetadataTag[]
  domainId   String? @map("domain_id")
  domain     MetadataDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workspaceId])
  @@index([dataSourceId])
  @@index([domainId])
  @@index([name])
  @@map("metadata_assets")
}

model MetadataSchema {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset   MetadataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  columns MetadataColumn[]

  @@unique([assetId, name])
  @@index([assetId])
  @@map("metadata_schemas")
}

model MetadataColumn {
  id          String   @id @default(uuid())
  schemaId    String   @map("schema_id")
  name        String
  dataType    String   @map("data_type")
  description String?
  isNullable  Boolean  @default(true) @map("is_nullable")
  ordinal     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schema MetadataSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([schemaId, name])
  @@index([schemaId])
  @@map("metadata_columns")
}

model MetadataOwner {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  email       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_owners")
}

model MetadataTag {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_tags")
}

model MetadataDomain {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MetadataAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("metadata_domains")
}

model Document {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  workspaceId String         @map("workspace_id")
  filename    String
  fileSize    Int            @map("file_size")
  mimeType    String         @map("mime_type")
  storagePath String         @unique @map("storage_path")
  status      DocumentStatus @default(UPLOADED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
  @@map("documents")
}
